{
  "id": "results_modal",
  "name": "ResultsModal",
  "scene": "res://scenes/ui/ResultsModal.tscn",
  "root_node": "ResultsModal",
  "script": "res://scripts/ui/ResultsModal.gd",
  "canvas_layer": 10,
  "z_index": 40,
  "default_visible": false,
  "layout": {
    "type": "full_screen_overlay",
    "anchor_full_rect": true
  },
  "nodes": [
    {
      "id": "results_modal",
      "name": "ResultsModal",
      "type": "Control",
      "parent": null,
      "children": ["Dimmer", "Panel"],
      "anchors": { "full_rect": true },
      "size": { "x": 720, "y": 1280 },
      "visible": false
    },
    {
      "id": "dimmer",
      "name": "Dimmer",
      "type": "ColorRect",
      "parent": "results_modal",
      "children": [],
      "anchors": { "full_rect": true },
      "size": { "x": 720, "y": 1280 },
      "style": { "color": "#000000", "alpha": 0.75 },
      "mouse_filter": 0
    },
    {
      "id": "panel",
      "name": "Panel",
      "type": "PanelContainer",
      "parent": "results_modal",
      "children": ["VBox"],
      "anchors": {
        "center_horizontal": true,
        "center_vertical": true
      },
      "offsets": { "left": -310, "top": -360, "right": 310, "bottom": 360 },
      "size": { "x": 620, "y": 720 },
      "style": {
        "sub_resources": {
          "StyleBoxFlat_modal_bg": {
            "type": "StyleBoxFlat",
            "bg_color": "#141A2E",
            "border_color": "#FF5A5E",
            "border_width_left": 2,
            "border_width_top": 2,
            "border_width_right": 2,
            "border_width_bottom": 2,
            "corner_radius_top_left": 18,
            "corner_radius_top_right": 18,
            "corner_radius_bottom_right": 18,
            "corner_radius_bottom_left": 18,
            "shadow_color": "#000000",
            "shadow_size": 24,
            "shadow_offset": { "x": 0, "y": 6 },
            "content_margin_left": 24,
            "content_margin_top": 24,
            "content_margin_right": 24,
            "content_margin_bottom": 24
          }
        },
        "theme_override_styles_panel": "StyleBoxFlat_modal_bg"
      }
    },
    {
      "id": "vbox",
      "name": "VBox",
      "type": "VBoxContainer",
      "parent": "panel",
      "children": ["TitleLabel", "HSeparator", "StatsVBox", "PrestigeContainer", "ContinueButton"],
      "style": { "separation": 18 }
