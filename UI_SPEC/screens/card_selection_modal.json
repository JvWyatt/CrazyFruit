        "rarity_colors": {
          "common": "#A6B8D1",
          "rare": "#5B9BF2",
          "epic": "#BF7EFF",
          "legendary": "#FFD54A"
        },
        "item_template": {
          "type": "PanelContainer",
          "property": "rarity_border_color",
          "style": {
            "sub_resources": {
              "StyleBoxFlat_card_common": {
                "type": "StyleBoxFlat",
                "bg_color": "#141A2E",
                "border_color": "#A6B8D1",
                "border_width_left": 2,
                "border_width_top": 2,
                "border_width_right": 2,
                "border_width_bottom": 2,
                "corner_radius_top_left": 12,
                "corner_radius_top_right": 12,
                "corner_radius_bottom_right": 12,
                "corner_radius_bottom_left": 12,
                "content_margin_left": 16,
