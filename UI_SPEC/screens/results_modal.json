        "colors": { "font_color": "#0E1320" },
        "font_sizes": { "font_size": 22 },
        "sub_resources": {
          "StyleBoxFlat_yellow_pill": {
            "type": "StyleBoxFlat",
            "bg_color": "#FFD54A",
            "border_color": "#FFD54A",
