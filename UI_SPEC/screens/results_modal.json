    {
      "id": "header_label",
      "name": "HeaderLabel",
      "type": "Label",
      "parent": "prestige_vbox",
      "children": [],
      "style": {
        "horizontal_alignment": "center",
        "colors": { "font_color": "#FFD54A" },
        "font_sizes": { "font_size": 16 }
      },
