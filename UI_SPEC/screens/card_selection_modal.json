                "content_margin_right": 16,
                "content_margin_bottom": 14
              },
              "StyleBoxFlat_card_rare": {
                "type": "StyleBoxFlat",
                "bg_color": "#141A2E",
                "border_color": "#5B9BF2",
                "border_width_left": 2,
                "border_width_top": 2,
                "border_width_right": 2,
                "border_width_bottom": 2,
                "corner_radius_top_left": 12,
                "corner_radius_top_right": 12,
                "corner_radius_bottom_right": 12,
                "corner_radius_bottom_left": 12,
                "content_margin_left": 16,
                "content_margin_top": 14,
                "content_margin_right": 16,
                "content_margin_bottom": 14
              },
              "StyleBoxFlat_card_epic": {
                "type": "StyleBoxFlat",
                "bg_color": "#1A1430",
                "border_color": "#BF7EFF",
                "border_width_left": 2,
                "border_width_top": 2,
                "border_width_right": 2,
                "border_width_bottom": 2,
                "corner_radius_top_left": 12,
                "corner_radius_top_right": 12,
                "corner_radius_bottom_right": 12,
                "corner_radius_bottom_left": 12,
                "content_margin_left": 16,
                "content_margin_top": 14,
                "content_margin_right": 16,
                "content_margin_bottom": 14
              },
              "StyleBoxFlat_card_legendary": {
                "type": "StyleBoxFlat",
                "bg_color": "#1E1C10",
                "border_color": "#FFD54A",
                "border_width_left": 2,
                "border_width_top": 2,
                "border_width_right": 2,
                "border_width_bottom": 2,
                "corner_radius_top_left": 12,
                "corner_radius_top_right": 12,
                "corner_radius_bottom_right": 12,
                "corner_radius_bottom_left": 12,
                "content_margin_left": 16,
                "content_margin_top": 14,
                "content_margin_right": 16,
                "content_margin_bottom": 14
              }
            }
          },
          "inner": {
            "type": "HBoxContainer",
            "style": { "separation": 14 },
            "children": [
              { "type": "Label", "property": "card_icon", "font_size": 38 },
              {
                "type": "VBoxContainer",
                "size_flags_horizontal": 3,
                "style": { "separation": 4 },
                "children": [
                  { "type": "Label", "property": "rarity_label", "font_size": 13, "property_color": "rarity_text_color" },
                  { "type": "Label", "property": "card_title", "font_size": 20, "color": "#FFFFFF" },
                  { "type": "Label", "property": "card_desc", "font_size": 15, "color": "#E6EDFB", "autowrap_mode": "word_wrapped" }
                ]
              },
              { "type": "Button", "size": { "x": 120, "y": 56 }, "property": "choose_button", "font_size": 14, "text": "ELEGIR\nCOMODÍN" }
            ]
          }
        }
      }
    }
  ],
  "interactions": [
    {
      "description": "Choose button on each card calls _on_card_chosen(card_id)"
    }
  ],
  "signals": [
    "card_chosen"
  ],
  "data_bindings": [
    { "source": "GameManager.day_earnings", "target": "earned_value.text", "format": "$%s" },
    { "source": "GameManager.day_tax", "target": "tax_value.text", "format": "-$%s" },
    { "source": "GameManager.day_profit", "target": "profit_value.text", "format": "$%s" },
    { "source": "GameManager.next_order_target", "target": "next_target_value.text", "format": "$%s" }
  ],
  "dynamic_elements": [
    {
      "element": "cards_vbox",
      "type": "programmatic_list",
      "builder": "_build_card_choices()",
      "description": "Builds card option rows with rarity-colored borders, icon, title, description, and choose button"
    },
    {
      "element": "card_selection_modal",
      "type": "animation",
      "trigger": "on_open",
      "animation": "confetti_burst",
      "description": "Confetti particle burst animation plays when modal opens"
    }
  ]
}