            "border_width_top": 2,
            "border_width_right": 2,
            "border_width_bottom": 2,
            "corner_radius_top_left": 18,
            "corner_radius_top_right": 18,
            "corner_radius_bottom_right": 18,
            "corner_radius_bottom_left": 18,
            "shadow_color": "#00000080",
            "shadow_size": 10,
            "shadow_offset": { "x": 0, "y": 4 },
            "content_margin_left": 20,
            "content_margin_top": 14,
            "content_margin_right": 20,
            "content_margin_bottom": 14
          },
          "StyleBoxFlat_yellow_pill_hover": {
            "type": "StyleBoxFlat",
            "bg_color": "#FFE066",
            "border_color": "#FFE066",
            "border_width_left": 2,
            "border_width_top": 2,
            "border_width_right": 2,
            "border_width_bottom": 2,
            "corner_radius_top_left": 18,
            "corner_radius_top_right": 18,
            "corner_radius_bottom_right": 18,
            "corner_radius_bottom_left": 18,
            "shadow_color": "#00000080",
            "shadow_size": 10,
            "shadow_offset": { "x": 0, "y": 4 },
            "content_margin_left": 20,
            "content_margin_top": 14,
            "content_margin_right": 20,
            "content_margin_bottom": 14
          },
          "StyleBoxFlat_yellow_pill_pressed": {
            "type": "StyleBoxFlat",
            "bg_color": "#E6B83A",
            "border_color": "#E6B83A",
            "border_width_left": 2,
            "border_width_top": 2,
            "border_width_right": 2,
            "border_width_bottom": 2,
            "corner_radius_top_left": 18,
            "corner_radius_top_right": 18,
            "corner_radius_bottom_right": 18,
            "corner_radius_bottom_left": 18,
            "shadow_size": 6,
            "shadow_offset": { "x": 0, "y": 2 },
            "content_margin_left": 20,
            "content_margin_top": 14,
            "content_margin_right": 20,
            "content_margin_bottom": 14
          }
