    {
      "id": "title_label",
      "name": "TitleLabel",
      "type": "Label",
      "parent": "vbox",
      "children": [],
      "style": {
        "horizontal_alignment": "center",
        "colors": {
          "font_color": "#FF5959",
          "font_shadow_color": "#000000",
          "shadow_offset_x": 3,
          "shadow_offset_y": 3
        },
        "font_sizes": { "font_size": 28 }
      },
      "text": "💀 NEGOCIO TERMINADO"
    },
    {
      "id": "hseparator",
      "name": "HSeparator",
      "type": "HSeparator",
      "parent": "vbox",
      "children": [],
      "style": { "colors": { "separator_color": "#FF5A5E" } }
    },
    {
      "id": "stats_vbox",
      "name": "StatsVBox",
      "type": "VBoxContainer",
      "parent": "vbox",
      "children": ["OrdersLabel", "MoneyLabel", "FruitsLabel", "JackpotsLabel", "GoldenLabel"],
      "style": { "separation": 10 }
    },
    {
      "id": "orders_label",
      "name": "OrdersLabel",
      "type": "Label",
      "parent": "stats_vbox",
