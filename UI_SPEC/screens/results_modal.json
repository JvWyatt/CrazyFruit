      "style": {
        "horizontal_alignment": "center",
        "colors": { "font_color": "#E6EDFB" },
        "font_sizes": { "font_size": 18 }
      },
      "text": "📋 Pedidos completados: 0",
      "data_binding": "GameManager.orders_completed"
    },
    {
      "id": "money_label",
      "name": "MoneyLabel",
      "type": "Label",
      "parent": "stats_vbox",
      "children": [],
      "style": {
        "horizontal_alignment": "center",
        "colors": { "font_color": "#E6EDFB" },
        "font_sizes": { "font_size": 18 }
      },
      "text": "💰 Dinero ganado: $0",
      "data_binding": "GameManager.run_money"
    },
    {
      "id": "fruits_label",
      "name": "FruitsLabel",
      "type": "Label",
      "parent": "stats_vbox",
      "children": [],
      "style": {
        "horizontal_alignment": "center",
        "colors": { "font_color": "#E6EDFB" },
        "font_sizes": { "font_size": 18 }
      },
      "text": "🍎 Frutas cortadas: 0",
