    {
      "id": "jackpots_label",
      "name": "JackpotsLabel",
      "type": "Label",
      "parent": "stats_vbox",
      "children": [],
      "style": {
        "horizontal_alignment": "center",
        "colors": { "font_color": "#E6EDFB" },
        "font_sizes": { "font_size": 18 }
      },
      "text": "🎰 Jackpots: 0",
      "data_binding": "StatsManager.jackpots_hit"
