        "theme_override_styles": {
          "normal": "StyleBoxFlat_yellow_pill",
          "hover": "StyleBoxFlat_yellow_pill_hover",
          "pressed": "StyleBoxFlat_yellow_pill_pressed"
        }
      },
      "text": "CONTINUAR"
    }
  ],
  "interactions": [
    {
      "node": "continue_button",
      "signal": "pressed",
      "action": "emit_signal('continue_requested')"
    }
  ],
  "signals": [
    "continue_requested"
  ],
  "data_bindings": [
    { "source": "GameManager.orders_completed", "target": "orders_label.text", "format": "📋 Pedidos completados: %s" },
    { "source": "GameManager.run_money", "target": "money_label.text", "format": "💰 Dinero ganado: $%s" },
    { "source": "StatsManager.total_fruits_cut", "target": "fruits_label.text", "format": "🍎 Frutas cortadas: %s" },
    { "source": "StatsManager.jackpots_hit", "target": "jackpots_label.text", "format": "🎰 Jackpots: %s" },
    { "source": "StatsManager.golden_fruits", "target": "golden_label.text", "format": "✨ Frutas doradas: %s" },
    { "source": "GameManager.prestige_earned", "target": "prestige_earned_label.text", "format": "+ %s ⭐" },
    { "source": "GameManager.total_prestige", "target": "total_prestige_label.text", "format": "⭐ Reputación total: %s" }
