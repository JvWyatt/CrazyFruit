    },
    {
      "id": "prestige_earned_label",
      "name": "PrestigeEarnedLabel",
      "type": "Label",
      "parent": "prestige_vbox",
      "children": [],
      "style": {
        "horizontal_alignment": "center",
        "colors": {
          "font_color": "#FFD54A",
          "font_shadow_color": "#000000",
          "shadow_offset_x": 2,
          "shadow_offset_y": 2
