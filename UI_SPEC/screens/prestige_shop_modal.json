{
  "id": "prestige_shop_modal",
  "name": "PrestigeShopModal",
  "scene": "res://scenes/ui/PrestigeShopModal.tscn",
  "root_node": "PrestigeShopModal",
  "script": "res://scripts/ui/PrestigeShopModal.gd",
  "canvas_layer": 10,
  "z_index": 30,
  "default_visible": false,
  "layout": {
    "type": "full_screen_overlay",
    "anchor_full_rect": true
  },
  "nodes": [
    {
      "id": "prestige_shop_modal",
      "name": "PrestigeShopModal",
      "type": "Control",
      "parent": null,
      "children": ["Dimmer", "Panel"],
      "anchors": { "full_rect": true },
      "size": { "x": 720, "y": 1280 },
      "visible": false
    },
    {
      "id": "dimmer",
      "name": "Dimmer",
      "type": "ColorRect",
      "parent": "prestige_shop_modal",
      "children": [],
      "anchors": { "full_rect": true },
      "size": { "x": 720, "y": 1280 },
      "style": { "color": "#000000", "alpha": 0.65 },
      "mouse_filter": 0
    },
    {
      "id": "panel",
      "name": "Panel",
      "type": "PanelContainer",
      "parent": "prestige_shop_modal",
      "children": ["VBox"],
      "anchors": {
        "center_horizontal": true,
        "center_vertical": true
      },
      "offsets": { "left": -320, "top": -380, "right": 320, "bottom": 380 },
      "size": { "x": 640, "y": 760 },
      "style": {
        "sub_resources": {
          "StyleBoxFlat_modal_bg": {
            "type": "StyleBoxFlat",
            "bg_color": "#141A2E",
            "border_color": "#FFD54A",
            "border_width_left": 2,
            "border_width_top": 2,
            "border_width_right": 2,
            "border_width_bottom": 2,
            "corner_radius_top_left": 18,
            "corner_radius_top_right": 18,
            "corner_radius_bottom_right": 18,
            "corner_radius_bottom_left": 18,
            "shadow_color": "#000000",
            "shadow_size": 20,
            "shadow_offset": { "x": 0, "y": 6 },
            "content_margin_left": 20,
            "content_margin_top": 20,
            "content_margin_right": 20,
            "content_margin_bottom": 20
          }
        },
        "theme_override_styles_panel": "StyleBoxFlat_modal_bg"
      }
    },
    {
      "id": "vbox",
      "name": "VBox",
      "type": "VBoxContainer",
      "parent": "panel",
      "children": ["HeaderHBox", "HSeparator", "ScrollContainer"],
      "style": { "separation": 16 }
    },
    {
      "id": "header_hbox",
      "name": "HeaderHBox",
      "type": "HBoxContainer",
      "parent": "vbox",
      "children": ["TitleLabel", "PrestigeLabel", "CloseButton"],
      "style": { "separation": 12, "alignment": "center" }
    },
    {
      "id": "title_label",
      "name": "TitleLabel",
      "type": "Label",
      "parent": "header_hbox",
      "children": [],
      "size_flags_horizontal": 3,
      "style": {
        "colors": {
          "font_color": "#FFD54A",
          "font_shadow_color": "#000000",
          "shadow_offset_x": 2,
          "shadow_offset_y": 2
        },
        "font_sizes": { "font_size": 24 }
      },
      "text": "⭐ Mercado de Prestigio"
    },
    {
      "id": "prestige_label",
      "name": "PrestigeLabel",
      "type": "Label",
      "parent": "header_hbox",
      "children": [],
      "style": {
        "colors": { "font_color": "#FFD54A" },
        "font_sizes": { "font_size": 18 }
      },
      "text": "⭐ 0 Rep.",
      "data_binding": "GameManager.prestige_points"
    },
    {
      "id": "close_button",
      "name": "CloseButton",
      "type": "Button",
      "parent": "header_hbox",
      "children": [],
      "size": { "x": 40, "y": 40 },
      "style": {
        "colors": { "font_color": "#A6B8D1" },
        "font_sizes": { "font_size": 18 },
        "sub_resources": {
          "StyleBoxFlat_circle": {
            "type": "StyleBoxFlat",
            "bg_color": "#1E233A",
            "corner_radius_top_left": 20,
            "corner_radius_top_right": 20,
            "corner_radius_bottom_right": 20,
            "corner_radius_bottom_left": 20
          }
        },
        "theme_override_styles": { "normal": "StyleBoxFlat_circle" }
      },
      "text": "✖"
    },
    {
      "id": "hseparator",
      "name": "HSeparator",
      "type": "HSeparator",
      "parent": "vbox",
      "children": [],
      "style": { "colors": { "separator_color": "#FFD54A" } }
    },
    {
      "id": "scroll_container",
      "name": "ScrollContainer",
      "type": "ScrollContainer",
      "parent": "vbox",
      "children": ["ItemsVBox"],
      "size_flags_horizontal": 3,
      "size_flags_vertical": 3,
      "script": "TouchScrollContainer"
    },
    {
      "id": "items_vbox",
      "name": "ItemsVBox",
      "type": "VBoxContainer",
      "parent": "scroll_container",
      "children": [],
      "size_flags_horizontal": 3,
      "style": { "separation": 14 },
      "dynamic_content": {
        "description": "Built programmatically by _build_prestige_items()",
        "item_type": "prestige_item",
        "item_template": {
          "type": "PanelContainer",
          "style": {
            "sub_resources": {
              "StyleBoxFlat_card": {
                "type": "StyleBoxFlat",
                "bg_color": "#141A2E",
                "border_color": "#FFD54A",
                "border_width_left": 1,
                "border_width_top": 1,
                "border_width_right": 1,
                "border_width_bottom": 1,
                "corner_radius_top_left": 12,
                "corner_radius_top_right": 12,
                "corner_radius_bottom_right": 12,
                "corner_radius_bottom_left": 12,
                "content_margin_left": 14,
                "content_margin_top": 12,
                "content_margin_right": 14,
                "content_margin_bottom": 12
              }
            }
          },
          "inner": {
            "type": "HBoxContainer",
            "children": [
              { "type": "Label", "property": "icon_emoji", "font_size": 32 },
              {
                "type": "VBoxContainer",
                "size_flags_horizontal": 3,
                "style": { "separation": 2 },
                "children": [
                  { "type": "Label", "property": "name", "font_size": 18, "color": "#FFD54A" },
                  { "type": "Label", "property": "description", "font_size": 14, "color": "#E6EDFB" }
                ]
              },
              { "type": "Button", "size": { "x": 130, "y": 48 }, "property": "buy_button", "font_size": 16, "format": "⭐ %s" }
            ]
          }
        }
      }
    }
  ],
  "interactions": [
    {
      "node": "close_button",
      "signal": "pressed",
      "action": "queue_free()"
    }
  ],
  "signals": [],
  "data_bindings": [
    { "source": "GameManager.prestige_points", "target": "prestige_label.text", "format": "⭐ %s Rep." }
  ],
  "dynamic_elements": [
    {
      "element": "items_vbox",
      "type": "programmatic_list",
      "builder": "_build_prestige_items()",
      "description": "Builds prestige upgrade cards with icon, name, description, and buy button showing star cost"
    }
  ]
}