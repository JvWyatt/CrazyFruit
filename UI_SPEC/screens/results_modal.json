      "style": {
        "sub_resources": {
          "StyleBoxFlat_prestige": {
            "type": "StyleBoxFlat",
            "bg_color": "#282E47",
            "border_color": "#FFD54A",
            "border_width_left": 1,
            "border_width_top": 1,
            "border_width_right": 1,
            "border_width_bottom": 1,
            "corner_radius_top_left": 12,
            "corner_radius_top_right": 12,
            "corner_radius_bottom_right": 12,
            "corner_radius_bottom_left": 12,
            "content_margin_left": 16,
            "content_margin_top": 14,
            "content_margin_right": 16,
            "content_margin_bottom": 14
          }
        },
        "theme_override_styles_panel": "StyleBoxFlat_prestige"
      }
    },
    {
      "id": "prestige_vbox",
      "name": "PrestigeVBox",
      "type": "VBoxContainer",
      "parent": "prestige_container",
      "children": ["HeaderLabel", "PrestigeEarnedLabel", "TotalPrestigeLabel"],
      "style": { "separation": 6 },
      "alignment": "center"
