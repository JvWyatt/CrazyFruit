      "parent": "prestige_vbox",
      "children": [],
      "style": {
        "horizontal_alignment": "center",
        "colors": { "font_color": "#E6EDFB" },
        "font_sizes": { "font_size": 14 }
      },
      "text": "⭐ Reputación total: 0",
      "data_binding": "GameManager.total_prestige"
    },
    {
